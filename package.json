    "lucide-react": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@playwright/cli": "latest",
    "@axe-core/playwright": "latest",
    "sharp": "latest",
    "prettier": "latest"
  }
